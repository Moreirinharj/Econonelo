def iniciar_minigame(personagem_id: int, profissao: str) -> dict:
    if profissao not in MINIGAMES_POR_PROFISSAO:
        return {"sucesso": False, "mensagem": "Sua profissão não tem minigame ainda."}
    minigame = MINIGAMES_POR_PROFISSAO[profissao]
    dados = minigame["funcao"](personagem_id)
    dados["sucesso"] = True
    dados["nome_minigame"] = minigame["nome"]
    return dados
