"""Minigames de profissões."""
import random
import database as db
from data import balanceamento as bal
from utils.logger import log_acao


def _recompensa_trabalho(personagem_id: int, profissao: str, multiplicador: float = 1.0) -> dict:
    salario = bal.obter_salario(profissao)
    ganho = int(random.randint(salario["min"], salario["max"]) * multiplicador)
    xp = int(salario["xp"] * multiplicador)
    resultado = db.registrar_trabalho_personagem(personagem_id, ganho, xp)
    return {"ganho": ganho, "xp": xp, "subiu_nivel": resultado["subiu_nivel"], "nivel": resultado["nivel"]}


# ===== POLICIAL MILITAR =====
CENARIOS_PATRULHA = [
    {"texto": "Você vê um suspeito correndo com uma bolsa.", "opcoes": ["Perseguir", "Chamar reforço", "Ignorar"], "correta": 0, "reward": 1.2},
    {"texto": "Um carro está em alta velocidade na contramão.", "opcoes": ["Bloquear a via", "Anotar a placa", "Sair do caminho"], "correta": 1, "reward": 0.8},
    {"texto": "Você ouve gritos vindos de um beco escuro.", "opcoes": ["Entrar sozinho", "Chamar reforço e entrar", "Ignorar"], "correta": 1, "reward": 1.5},
    {"texto": "Uma loja está sendo arrombada à noite.", "opcoes": ["Entrar atirando", "Cercar e chamar apoio", "Esperar o ladrão sair"], "correta": 1, "reward": 1.3},
    {"texto": "Um cidadão pede ajuda: perdeu o filho no parque.", "opcoes": ["Iniciar busca", "Dizer pra ele procurar", "Chamar a central"], "correta": 0, "reward": 1.0},
]


def minigame_patrulha(personagem_id: int) -> dict:
    cenario = random.choice(CENARIOS_PATRULHA)
    return {"tipo": "patrulha", "texto": cenario["texto"], "opcoes": cenario["opcoes"],
            "correta": cenario["correta"], "reward": cenario["reward"], "personagem_id": personagem_id}


def resolver_patrulha(personagem_id: int, escolha: int, correta: int, reward: float) -> dict:
    if escolha == correta:
        recompensa = _recompensa_trabalho(personagem_id, "policial_militar", reward)
        db.modificar_status_personagem(personagem_id, "reputacao", bal.REPUTACAO_POR_TRABALHO)
        return {"sucesso": True, "mensagem": "✅ Boa decisão, policial!", "recompensa": recompensa}
    else:
        recompensa = _recompensa_trabalho(personagem_id, "policial_militar", 0.3)
        db.modificar_status_personagem(personagem_id, "estresse", 10)
        return {"sucesso": False, "mensagem": "❌ Decisão errada. Você foi advertido.", "recompensa": recompensa}


