# ===== CRIMINOSO =====
CENARIOS_CRIME = [
    {"texto": "Oportunidade de roubar uma loja deserta à noite.", "opcoes": ["Invadir pela frente", "Invadir pelos fundos", "Desistir", "Colocar fogo na loja"], "correta": 1, "reward": 1.5, "risco": 0.3},
    {"texto": "Um rival da facção apareceu no seu território.", "opcoes": ["Confrontar diretamente", "Chamar os parceiros", "Ignorar", "Fugir"], "correta": 1, "reward": 1.2, "risco": 0.5},
    {"texto": "A polícia está fazendo blitz na sua rota de fuga.", "opcoes": ["Passar pela blitz", "Dar meia volta", "Abandonar o carro e correr", "Se entregar"], "correta": 1, "reward": 0.8, "risco": 0.4},
]


def minigame_crime(personagem_id: int) -> dict:
    cenario = random.choice(CENARIOS_CRIME)
    return {"tipo": "crime", "texto": cenario["texto"], "opcoes": cenario["opcoes"],
            "correta": cenario["correta"], "reward": cenario["reward"], "risco": cenario["risco"],
            "personagem_id": personagem_id}


def resolver_crime(personagem_id: int, escolha: int, correta: int, reward: float, risco: float) -> dict:
    if escolha == correta:
        if random.random() < risco:
            db.prender_personagem(personagem_id)
            db.adicionar_registro_criminal(personagem_id, "Preso em flagrante")
            db.modificar_status_personagem(personagem_id, "reputacao", bal.REPUTACAO_POR_CRIME)
            return {"sucesso": False, "mensagem": "🔒 Você foi preso em flagrante!", "recompensa": None, "preso": True}
        recompensa = _recompensa_trabalho(personagem_id, "criminoso", reward)
        db.modificar_status_personagem(personagem_id, "reputacao", bal.REPUTACAO_POR_CRIME)
        return {"sucesso": True, "mensagem": "✅ Crime bem sucedido... por enquanto.", "recompensa": recompensa, "preso": False}
    else:
        if random.random() < risco * 1.5:
            db.prender_personagem(personagem_id)
            db.adicionar_registro_criminal(personagem_id, "Preso em flagrante")
            return {"sucesso": False, "mensagem": "🔒 Deu tudo errado! Você foi preso!", "recompensa": None, "preso": True}
        recompensa = _recompensa_trabalho(personagem_id, "criminoso", 0.1)
        db.modificar_status_personagem(personagem_id, "estresse", 20)
        return {"sucesso": False, "mensagem": "❌ Operação fracassada. Você escapou por pouco.", "recompensa": recompensa, "preso": False}


