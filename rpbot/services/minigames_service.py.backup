            "correta": cenario["correta"], "reward": cenario["reward"], "personagem_id": personagem_id}


def resolver_audiencia(personagem_id: int, escolha: int, correta: int, reward: float) -> dict:
    personagem = db.obter_personagem_por_id(personagem_id)
    profissao = personagem["profissao"] if personagem and personagem["profissao"] else "advogado"
    if escolha == correta:
        recompensa = _recompensa_trabalho(personagem_id, profissao, reward)
        db.modificar_status_personagem(personagem_id, "reputacao", 3)
        return {"sucesso": True, "mensagem": "✅ Excelente argumentação! Cliente satisfeito.", "recompensa": recompensa}
    else:
        recompensa = _recompensa_trabalho(personagem_id, profissao, 0.3)
        db.modificar_status_personagem(personagem_id, "estresse", 15)
        return {"sucesso": False, "mensagem": "❌ Péssima atuação. Cliente vai te processar.", "recompensa": recompensa}


